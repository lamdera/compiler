packages:
    ./
    ./vendor/elm-format/elm-format-markdown
    ./vendor/elm-format/elm-format-lib
    ./vendor/elm-format/avh4-lib
    ./vendor/elm-format

-- @LAMDERA stack.yaml sets a GLOBAL `allow-newer: true`, which relaxes both
-- upper and lower dependency bounds across the whole build. The cabal-based
-- (docker/musl) builds must mirror that or they diverge from the stack build
-- and fail to resolve - under GHC 9.8.4 the shifted global packages (bytestring
-- 0.12, ansi-terminal 1.1, ...) trip vendored elm-format's and ansi-wl-pprint's
-- upper bounds. Exact versions are still pinned by cabal.project.freeze (spliced
-- from `stack ls dependencies`), so relaxing the bounds here is safe.
--
-- (Was a targeted `allow-older:` list for text/aeson pre-0.19.2; the 9.8.4
-- toolchain needs the full global relaxation stack already uses.)
allow-newer: all
allow-older: all

source-repository-package
    type: git
    location: https://github.com/noteed/language-glsl.git
    tag: 99c3aae76363b127679da640a6f00d61d2203830

-- @LAMDERA build every dependency with -split-sections, not just our own packages. The
-- musl release builds pass -split-sections in `cabal build --ghc-options`, but cabal
-- applies command line ghc-options to local packages only, so the ~150 Hackage
-- dependencies were built as one .text section per module, and the link's
-- --gc-sections (which GHC passes on ELF) could drop nothing from them: any module the
-- binary touched came in whole, Typeable metadata, unused instances and all.
-- Linux only in effect: Mach-O dead-strips per symbol without it (except on
-- aarch64-darwin, where GHC can't), and stack/nix builds don't read this file.
package *
  split-sections: True

-- @LAMDERA snap-server's foreign import calls sendfile64, which musl >= 1.2.4 (the
-- ghc-musl base's alpine, used by the Linux release builds) no longer offers to static
-- links. Alias it to sendfile, the same function on musl (off_t is always 64 bit); -u
-- makes sure sendfile is linked. Only on the elm package, whose one component is the
-- executable: on a library's shared object link (the vendored elm-format packages)
-- there is no libc to find sendfile in, and --defsym fails the link.
if os(linux)
  package elm
    ghc-options: -optl-Wl,-u,sendfile -optl-Wl,--defsym=sendfile64=sendfile
